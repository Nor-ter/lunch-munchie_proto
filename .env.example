# The normal Cloudflare Pages local flow does not need a `.env` file.
# Copy `.dev.vars.example` to `.dev.vars` for the required Google OAuth secrets.

# Optional: enables interactive Google Maps on map screens. This browser key must
# be restricted to allowed HTTP referrers in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
# Reserved for a future Next.js client migration. Keep the same browser-restricted
# value as VITE_GOOGLE_MAPS_API_KEY while both build systems are supported.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
