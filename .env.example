# Copy to .env and fill in values (optional for local dev)

# PostgreSQL (data-jp API — optional, mock fallback when unset)
DATABASE_URL=postgresql://user:password@localhost:5432/lunchie_munchie

# Umami analytics (optional — omit to disable)
VITE_ANALYTICS_ENDPOINT=https://your-umami-instance.com
VITE_ANALYTICS_WEBSITE_ID=your_website_id

# OAuth / Manus auth
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Supabase browser client (public project URL + anon/publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# New Supabase projects may use a publishable key instead of the legacy anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase authentication compatibility
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Google Maps (via Forge proxy) — 죽은 데모(Map.tsx)용, 미사용
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Google Maps JS — web-maps-places-workflow.md Phase 0.
# 웹 전용 브라우저 키(Maps JavaScript API 활성화 + HTTP referrer 제한). 모바일 SDK 키와 별개.
# Places/Directions는 이 키가 아니라 Edge Function(서버 키)으로 호출 — 이 키는 지도 타일 표시 전용.
VITE_GOOGLE_MAPS_API_KEY=
