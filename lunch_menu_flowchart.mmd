graph TD
    A([Start: 런치 메뉴 추천 요청]) --> B{데이터 수집}
    
    B --> C1[사용자 정보: 선호도/기피/예산]
    B --> C2[세션 조건: 위치/시간 제약]
    B --> C3[과거 기록: 최근 식사 히스토리]
    B --> C4[(전체 식당/메뉴 DB)]
    
    C1 --> D[STEP 1: 하드 필터링]
    C2 --> D
    C3 --> D
    C4 --> D
    
    D --> E{필터 통과 여부}
    E -- 예산 초과 --> F[후보 제외]
    E -- 세션 제약(위치 등) 불일치 --> F
    E -- 알레르기/기피 식재료 --> F
    E -- 통과 --> G[STEP 2: 가중치 스코어링]
    
    G --> H1[+ 선호도 보너스]
    G --> H4[- 과거 섭취 페널티]
    
    H1 --> I[메뉴별 총점 합산]
    H4 --> I
    
    I --> J[Top N 후보 선정]
    J --> K[STEP 3: 무작위성 부여]
    K --> L[상위 후보군에 랜덤 가중치 추가]
    L --> M([최종 재정렬 및 상위 1~3개 추천])
    
    M --> N{사용자 피드백}
    N -- 메뉴 선택 완료 --> O[(히스토리 DB 업데이트)]
    N -- Skip / 다시 뽑기 --> P[해당 메뉴 페널티 부여 후 재추천]
    P --> M
