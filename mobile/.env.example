# Copy to .env and fill in values
#
# Phase 6: EXPO_PUBLIC_GOOGLE_PLACES_API_KEY(구 클라이언트 직접 Places 호출용)는 제거했다.
# EXPO_PUBLIC_ 접두사가 붙은 값은 참조 여부와 무관하게 Expo가 무조건 앱 바이너리에
# 임베드한다(공식 문서화된 동작) — 워크플로우 §2 "Google 키는 절대 RN 번들에 넣지
# 않는다"를 어기고 있었다. 실제 사용처(hooks/useNearbyPlaces.ts, components/
# NearbyPlaceSheet.tsx)도 Phase 4에서 Edge Function 프록시(services/placesApi.ts)로
# 대체돼 미사용 상태였던 걸 이번에 함께 삭제했다. 검색/자동완성/상세조회는 이제
# 전부 Supabase Edge Function을 거친다(서버 키는 Edge Function env에만 존재).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 지도(Google Maps) — react-native-maps용. 네이티브 빌드(dev client/EAS/expo run)에서만 반영됨.
# Expo Go 테스트에는 불필요. Maps SDK for Android / Maps SDK for iOS를 켠 키를 사용.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 로그인(Google) — login-workflow.md §5.2. 공개 OAuth 클라이언트 식별자(시크릿 아님).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
