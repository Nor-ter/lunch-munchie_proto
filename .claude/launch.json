{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:server"],
      "port": 3000
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "dev-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:client", "--", "--port", "0"],
      "port": 5173,
      "autoPort": true
    }
  ]
}
